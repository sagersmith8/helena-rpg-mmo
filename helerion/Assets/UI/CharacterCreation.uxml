<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <!-- Root: full screen so it fits any device (e.g. Galaxy S21) -->
  <ui:VisualElement name="root" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 12; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 200);">
    <!-- Scroll so the form is always reachable on short or keyboard-up screens -->
    <ui:ScrollView style="flex-grow: 1; align-self: stretch; -unity-content-container: stretch;">
      <!-- Panel: most of screen width, readable on phones -->
      <ui:VisualElement name="form-panel" style="width: 92%; max-width: 420; min-width: 280; padding: 20; margin: 12; background-color: rgba(40, 40, 40, 255); border-radius: 8; align-self: center;">
        <ui:Label text="Character Creation" style="font-size: 26; -unity-font-style: bold; margin-bottom: 16;" />
        <ui:TextField name="name-field" label="Name" value="" style="margin-bottom: 14; font-size: 18;" />
        <ui:DropdownField name="ancestry-dropdown" label="Ancestry" style="margin-bottom: 14; font-size: 18;" />
        <ui:DropdownField name="background-dropdown" label="Background" style="margin-bottom: 14; font-size: 18;" />
        <ui:DropdownField name="class-dropdown" label="Class" style="margin-bottom: 14; font-size: 18;" />
        <ui:Label name="stats-label" text="Speed: --  HP: --  Mana: --" style="margin-bottom: 10; font-size: 15; white-space: normal;" />
        <ui:Label name="status-label" text="" style="margin-bottom: 12; color: rgba(255, 200, 100, 255); min-height: 20; font-size: 15;" />
        <ui:Button name="create-button" text="Create Character" style="margin-top: 12; min-height: 52; font-size: 18;" />
      </ui:VisualElement>
    </ui:ScrollView>
  </ui:VisualElement>
</ui:UXML>
