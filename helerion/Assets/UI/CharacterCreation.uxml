<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <ui:VisualElement name="root" style="flex-grow: 1; padding: 24; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 180);">
    <ui:VisualElement style="width: 320; padding: 20; background-color: rgba(40, 40, 40, 255); border-radius: 8;">
      <ui:Label text="Character Creation" style="font-size: 20; -unity-font-style: bold; margin-bottom: 16;" />
      <ui:TextField name="name-field" label="Name" value="" style="margin-bottom: 12;" />
      <ui:DropdownField name="ancestry-dropdown" label="Ancestry" style="margin-bottom: 12;" />
      <ui:DropdownField name="background-dropdown" label="Background" style="margin-bottom: 12;" />
      <ui:DropdownField name="class-dropdown" label="Class" style="margin-bottom: 12;" />
      <ui:Label name="stats-label" text="Speed: --  HP: --  Mana: --" style="margin-bottom: 8; font-size: 12; white-space: normal;" />
      <ui:Label name="status-label" text="" style="margin-bottom: 12; color: rgba(255, 200, 100, 255); min-height: 18;" />
      <ui:Button name="create-button" text="Create Character" style="margin-top: 8;" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
